/* =========================
   OPENING / ENVELOPE
========================= */

.opening{
    position:fixed;
    inset:0;
    z-index:9999;
    display:grid;
    place-items:center;
    background:
        radial-gradient(
            circle at 50% 25%,
            rgba(255,255,255,.8),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #e7ddd2,
            #faf5ee,
            #dcd0c3
        );
    transition:
        opacity .9s ease,
        visibility .9s ease;
}

.opening.hidden{
    opacity:0;
    visibility:hidden;
    pointer-events:none;
}

.opening-inner{
    width:90%;
    max-width:420px;
    text-align:center;
}

.kicker{
    font-size:11px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:#76695e;
    margin-bottom:25px;
}

.envelope-wrap{
    width:100%;
    aspect-ratio:1.4;
    position:relative;
    perspective:900px;
}

.envelope{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    padding:0;
    border:0;
    background:none;
    cursor:pointer;
}

.env-back{
    position:absolute;
    inset:0;
    border-radius:8px;
    background:
        linear-gradient(
            145deg,
            #eee4da,
            #d7c7b8
        );
    box-shadow:
        0 20px 40px rgba(40,30,20,.18);
}

.env-paper{
    position:absolute;
    z-index:1;
    left:9%;
    right:9%;
    top:8%;
    height:84%;
    background:#fffdf8;
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow:
        0 5px 20px rgba(40,30,20,.08);
}

.env-paper span{
    font-size:14px;
    letter-spacing:3px;
    color:#62564c;
}

.env-flap{
    position:absolute;
    z-index:3;
    left:0;
    right:0;
    top:0;
    height:64%;
    background:
        linear-gradient(
            160deg,
            #f0e5da,
            #d9c9ba
        );
    clip-path:polygon(
        0 0,
        100% 0,
        50% 100%
    );
    transform-origin:50% 0;
    transition:
        transform 1.05s
        cubic-bezier(.2,.75,.2,1);
    border-radius:8px 8px 0 0;
}

.env-front{
    position:absolute;
    z-index:4;
    left:0;
    right:0;
    bottom:0;
    height:58%;
    background:
        linear-gradient(
            155deg,
            #e2d3c4,
            #d0bdab
        );
    clip-path:polygon(
        0 0,
        50% 55%,
        100% 0,
        100% 100%,
        0 100%
    );
    border-radius:0 0 8px 8px;
}

.seal{
    position:absolute;
    z-index:5;
    left:50%;
    top:49%;
    transform:translate(-50%,-50%);
    width:55px;
    height:55px;
    border-radius:50%;
    background:#9c7c5b;
    color:white;
    display:grid;
    place-items:center;
    font-size:22px;
    box-shadow:
        0 6px 15px rgba(50,35,20,.2);
    transition:.6s;
}

.opening.opened .env-flap{
    transform:rotateX(175deg);
}

.opening.opened .seal{
    opacity:0;
    transform:
        translate(-50%,-50%)
        scale(.2);
}

.open-btn{
    margin-top:28px;
    padding:14px 25px;
    border:1px solid #766453;
    border-radius:30px;
    background:rgba(255,255,255,.4);
    color:#3a312b;
    cursor:pointer;
    text-transform:uppercase;
    letter-spacing:1px;
    font-size:12px;
}

.hint{
    margin-top:12px;
    font-size:12px;
    color:#76695e;
}

/* =========================
   MAIN SITE
========================= */

