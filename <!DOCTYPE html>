<title>Аскар & Ажар — 02.10.2026</title>

<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:#f4eee8;
  color:#40362f;
  font-family:Georgia,"Times New Roman",serif;
  overflow-x:hidden;
}
button,input,textarea{font:inherit}
button{cursor:pointer}

#opening{
  position:fixed;
  inset:0;
  z-index:9999;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#e9dfd5;
  transition:opacity 1.2s ease,visibility 1.2s ease;
}
#opening.closed{opacity:0;visibility:hidden;pointer-events:none}

.envelope-wrap{
  width:min(88vw,390px);
  text-align:center;
}
.envelope{
  position:relative;
  width:100%;
  aspect-ratio:1.38;
  cursor:pointer;
  perspective:900px;
  filter:drop-shadow(0 22px 35px rgba(60,45,35,.18));
}
.env-back{
  position:absolute;
  inset:0;
  background:#d5c1b0;
  border-radius:5px;
}
.env-paper{
  position:absolute;
  z-index:2;
  left:8%;
  right:8%;
  top:12%;
  height:76%;
  background:#fffaf4;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 5px 15px rgba(0,0,0,.08);
}
.env-paper-inner{
  text-align:center;
  color:#54443a;
}
.env-paper-inner .small{
  display:block;
  margin-top:9px;
  font-size:10px;
  letter-spacing:3px;
}
.env-flap{
  position:absolute;
  z-index:4;
  inset:0;
  background:#c8b09d;
  clip-path:polygon(0 0,50% 62%,100% 0);
  transform-origin:top center;
  transition:transform 1s cubic-bezier(.2,.7,.2,1);
}
.envelope.open .env-flap{
  transform:rotateX(180deg);
}
.env-front{
  position:absolute;
  z-index:5;
  left:0;
  right:0;
  bottom:0;
  height:50%;
  background:#d0b9a5;
  clip-path:polygon(0 100%,0 0,50% 70%,100% 0,100% 100%);
  pointer-events:none;
}
.env-seal{
  position:absolute;
  z-index:6;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  width:55px;
  height:55px;
  border-radius:50%;
  background:#9c7b65;
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  transition:opacity .5s,transform .5s;
}
.envelope.open .env-seal{
  opacity:0;
  transform:translate(-50%,-50%) scale(.5);
}
.open-hint{
  margin-top:28px;
  font-size:11px;
  letter-spacing:3px;
  color:#705e50;
}

#site{
  opacity:0;
  transition:opacity 1.3s ease;
}
#site.visible{opacity:1}

section{
