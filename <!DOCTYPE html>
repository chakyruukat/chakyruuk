<script>
const opening = document.getElementById("opening");
const envelope = document.getElementById("envelope");
const site = document.getElementById("site");
const music = document.getElementById("music");
const musicControl = document.getElementById("musicControl");

let autoScrolling = false;
let animationFrame = null;

envelope.addEventListener("click", function(){

  envelope.classList.add("open");

  setTimeout(function(){

    opening.classList.add("closed");
    site.classList.add("visible");

    music.volume = 0.75;

    const playPromise = music.play();

    if(playPromise){
      playPromise.catch(function(){});
    }

    musicControl.classList.add("show");

    startAutoScroll();

  },900);
});

musicControl.addEventListener("click",function(){

  if(music.paused){
    music.play().catch(function(){});
    musicControl.textContent="♫";
  }else{
    music.pause();
    musicControl.textContent="Ⅱ";
  }

});

function startAutoScroll(){

  if(autoScrolling) return;

  autoScrolling=true;

  let last=performance.now();
  let accumulator=0;

  function move(now){

    if(!autoScrolling) return;

    accumulator += now-last;
    last=now;

    if(accumulator>35){

      window.scrollBy(0,0.55);
      accumulator=0;

    }

    if(window.innerHeight + window.scrollY >= document.body.scrollHeight - 2){

      autoScrolling=false;
      return;

    }

    animationFrame=requestAnimationFrame(move);
  }

  animationFrame=requestAnimationFrame(move);
}

function stopAutoScroll(){

  autoScrolling=false;

  if(animationFrame){
    cancelAnimationFrame(animationFrame);
    animationFrame=null;
  }
}

window.addEventListener("wheel",stopAutoScroll,{passive:true});
window.addEventListener("touchstart",stopAutoScroll,{passive:true});
window.addEventListener("pointerdown",function(e){

  if(!e.target.closest("#opening")){
    stopAutoScroll();
  }

},{passive:true});

const weddingDate = new Date("2026-10-02T15:00:00+06:00").getTime();

function updateCountdown(){

  let difference = Math.max(0,weddingDate-Date.now());

  const days = Math.floor(difference/86400000);

  difference %= 86400000;

  const hours = Math.floor(difference/3600000);

  difference %= 3600000;

  const minutes = Math.floor(difference/60000);

  const seconds = Math.floor((difference%60000)/1000);

  const values=[
    days,
    hours,
    minutes,
    seconds
  ];

  document.querySelectorAll("#countdown .time-box b").forEach(function(element,index){

    element.textContent=String(values[index]).padStart(2,"0");

  });

}

updateCountdown();
setInterval(updateCountdown,1000);

document.getElementById("rsvpForm").addEventListener("submit",function(event){

  event.preventDefault();

  const name=document.getElementById("guestName").value.trim();

  const message=
    "Саламатсыздарбы! Мен "+name+
    " — Аскар & Ажардын тоюна катышаарымды ырастайм. 🤍";

  window.open(
    "https://wa.me/?text="+encodeURIComponent(message),
    "_blank"
  );

});

const STORAGE_KEY="askar_azhar_wishes";

function escapeHTML(value){

  return String(value).replace(/[&<>"']/g,function(char){

    const map={
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#039;"
    };

    return map[char];

  });

}

function getWishes(){

  try{
    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
  }catch(error){
    return [];
  }

}

function saveWishes(wishes){

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(wishes)
  );

}

function renderWishes(){

  const list=document.getElementById("wishList");
  const wishes=getWishes();

  if(!wishes.length){

    list.innerHTML=
      '<div class="empty-wishes">Азырынча биринчи тилекти сиз калтырыңыз 🤍</div>';

    return;
  }

  list.innerHTML=wishes.map(function(item){

    return `
      <div class="wish">
        <div class="wish-name"><strong>${escapeHTML(item.name)}</strong></div>
        <div class="wish-text">${escapeHTML(item.text)}</div>
      </div>
    `;

  }).join("");

}

document.getElementById("wishForm").addEventListener("submit",function(event){

  event.preventDefault();

  const name=document.getElementById("wishName").value.trim();
  const text=document.getElementById("wishText").value.trim();

  if(!name || !text) return;

  const wishes=getWishes();

  wishes.unshift({
    name:name,
    text:text,
    date:Date.now()
  });

  saveWishes(wishes);

  this.reset();

  renderWishes();

  document.getElementById("wishList").scrollIntoView({
    behavior:"smooth",
    block:"start"
  });

});

renderWishes();
</script>

